<Window x:Class="demo2.Views.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo2.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        FontSize="18"
        FontFamily="Times New Roman"
        Background="#FFFFFF"
        Title="Список продуктов" Height="750" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
            <Image Source="/Images/Icon.png" Width="50" Margin="10"/>
            <TextBlock Text="Обувь" FontSize="20" VerticalAlignment="Center" Margin="10"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="Заказы" Name="OpenOrderBtn" Margin="10,0" VerticalAlignment="Center" 
                    Padding="10,5" Background="#7FFF00" Click="OpenOrderBtn_Click"/>
            <TextBlock Text="{Binding User.UserName}" Margin="10,0" TextAlignment="Center" VerticalAlignment="Center"/>
            <Button Content="Выйти" Name="LogoutBtn" Click="LogoutBtn_Click" Margin="10" 
                    VerticalAlignment="Center" Padding="10,5" Background="#00FA9A"/>
        </StackPanel>

        <TextBlock Text="Список товаров" Grid.Column="0" Grid.Row="1" FontSize="24" FontWeight="Bold" Margin="10"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Name="ProductsSearch" Margin="10">
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Сортировка по количеству на складе" Margin="10" TextAlignment="Center"/>
                <ComboBox SelectedIndex="{Binding SelectedSort}" SelectionChanged="ComboBox_SelectionChanged">
                    <ComboBoxItem Content="по возрастанию"/>
                    <ComboBoxItem Content="по убыванию"/>
                </ComboBox>
            </StackPanel>
            
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Фильтрация" Margin="10" TextAlignment="Center"/>
                <ComboBox Name="FilterBox" SelectionChanged="FilterBox_SelectionChanged" Width="200"
                          ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name" SelectedItem="{Binding Supplier}"/>
            </StackPanel>
            
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Поиск" Margin="10" TextAlignment="Center"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" TextChanged="TextBox_TextChanged"/>
            </StackPanel>
        </StackPanel>
        
        <ListBox Grid.ColumnSpan="2" Grid.Row="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding Products}" SelectedItem="{Binding Product}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding BackgroundColor}" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <Image Name="ProductImage" Loaded="ProductImage_Loaded" Width="100" Grid.Column="0" Margin="10"/>

                            <StackPanel Orientation="Vertical" Grid.Column="1">
                                <TextBlock FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="5">
                                    <Run Text="{Binding Category.Name}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding Name}"/>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Margin="5">
                                    <Run Text="Описание товара: "/>
                                    <Run Text="{Binding Description}"/>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Margin="5">
                                    <Run Text="Производитель: "/>
                                    <Run Text="{Binding Manufacturer.Name}"/>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Margin="5">
                                    <Run Text="Поставщик: "/>
                                    <Run Text="{Binding Supplier.Name}"/>
                                </TextBlock>

                                <StackPanel Orientation="Vertical" Margin="2">
                                    <TextBlock Text="Цена: "/>
                                    <TextBlock Foreground="Red" Text="{Binding OldPrice, StringFormat={}{0:0.##} руб.}" TextDecorations="Strikethrough" Visibility="{Binding OldPriceVisibility}"/>
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:0.##} руб.}" FontSize="23" FontWeight="Bold"/>
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap" Margin="5">
                                    <Run Text="Единица измерения: "/>
                                    <Run Text="{Binding UnitOfMeasurement}"/>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Margin="5">
                                    <Run Text="Количество на складе: "/>
                                    <Run Text="{Binding CountInStock}"/>
                                </TextBlock>

                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock FontSize="25" FontWeight="Bold">
                                    <Run Text="{Binding CurrentDiscount}" />
                                    <Run Text="%"/>
                                </TextBlock>
                            </StackPanel>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.ColumnSpan="2" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10" VerticalAlignment="Center" Name="ControlBtns">
            <Button Content="Добавить" Name="AddProductBtn" Click="AddProductBtn_Click" Margin="10" Padding="10,5" FontSize="20" Background="#00FA9A" Width="200"/>
            <Button Content="Удалить" Name="DeleteProductBtn" Click="DeleteProductBtn_Click" Margin="10" Padding="20,10" FontSize="20" Background="#00FA9A" Width="200"/>
        </StackPanel>
    </Grid>
</Window>
