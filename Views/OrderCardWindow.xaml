<Window x:Class="demo2.Views.OrderCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo2.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        FontSize="18"
        FontFamily="Times New Roman"
        Background="#FFFFFF"
        ScrollViewer.CanContentScroll="True"
        Title="Карточка заказа" Height="1000" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center"  Margin="10">
            <TextBlock Text="Заказ" FontSize="25" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Margin="5" TextAlignment="Center" Name="OrderIdBlock">
                <Run Text="Номер: "/>
                <Run Text="{Binding Order.IdOrder}"/>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10">
            <TextBlock Text="Дата заказа" Margin="10"/>
            <DatePicker SelectedDate="{Binding Order.OrderDate, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10">
            <TextBlock Text="Дата доставки" Margin="10"/>
            <DatePicker SelectedDate="{Binding Order.DeliveryDate, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Stretch" 
                    Grid.Row="2" Grid.ColumnSpan="2" Margin="10" 
                    Orientation="Vertical">
            <TextBlock Text="ФИО заказчика" Margin="10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Margin="10" Grid.Column="0">
                    <TextBlock Text="Фамилия"/>
                    <TextBox Text="{Binding Order.Person.Surname}"/>
                </StackPanel>
                <StackPanel Margin="10" Grid.Column="1">
                    <TextBlock Text="Имя"/>
                    <TextBox Text="{Binding Order.Person.FirstName}"/>
                </StackPanel>
                <StackPanel Margin="10" Grid.Column="2"> 
                    <TextBlock Text="Отчество" />
                    <TextBox Text="{Binding Order.Person.Patronymic}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
        
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="10" Orientation="Vertical" 
                    HorizontalAlignment="Stretch">
            <TextBlock Text="Адрес доставки" Margin="10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="10" Grid.Column="0">
                    <TextBlock Text="Индекс"/>
                    <TextBox Text="{Binding Order.Adress.Index, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Margin="10" Grid.Column="1">
                    <TextBlock Text="Город"/>
                    <TextBox Text="{Binding Order.Adress.Sity.Name, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Margin="10" Grid.Column="2">
                    <TextBlock Text="Улица" />
                    <TextBox Text="{Binding Order.Adress.Street, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Margin="10" Grid.Column="3">
                    <TextBlock Text="Дом" />
                    <TextBox Text="{Binding Order.Adress.House, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="0" Margin="10">
            <TextBlock Text="Код получения" Margin="10"/>
            <TextBox Text="{Binding Order.Kod, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="1" Margin="10">
            <TextBlock Text="Статус" Margin="10"/>
            <TextBox Name="CountBox" Text="{Binding Order.OrderStatus, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Text="Список товаров" Margin="20" Grid.ColumnSpan="2" Grid.Row="5"/>

        <ListBox ItemsSource="{Binding Order.OrderItems}"
                 SelectedItem="{Binding OrderItem}"
                 Grid.ColumnSpan="2" Grid.Row="6"
                 HorizontalAlignment="Stretch" 
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Margin="10,5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="10" Grid.Column="0">
                            <TextBlock Text="Название|артикул"/>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding Name}"/>
                                <Run Text=" | "/>
                                <Run Text="{Binding Artikul}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Margin="10" Grid.Column="1">
                            <TextBlock Text="Количество"/>
                            <TextBlock Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Margin="10" Grid.Column="2">
                            <TextBlock Text="Цена за шт." />
                            <TextBlock Text="{Binding Price, StringFormat={}{0:0.##} руб., UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="0" Grid.Row="7" Margin="10">
            <TextBlock Text="Товар" Margin="10"/>
            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Name}"/>
                            <Run Text=" | "/>
                            <Run Text="{Binding Artikul}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Количество" Margin="10"/>
            <TextBox Text="{Binding ProductCount, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        
        <StackPanel Grid.Column="1" Grid.Row="7" Margin="10,30">
            <Button Content="Добавить товар" Name="AddProductBtn" 
                    Click="AddProductBtn_Click"
                    Margin="0,20" Background="#7FFF00"/>
            <Button Content="Удалить товар" Name="DeleteProductBtn" 
                    Click="DeleteProductBtn_Click"
                    Margin="0,20" Background="#7FFF00"/>
        </StackPanel>
        
        
        <StackPanel Grid.Row="8" Grid.Column="1" Margin="10" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="Итого: " VerticalAlignment="Center"/>
            <TextBlock FontSize="24" Text="{Binding Order.TotalPrice, StringFormat={}{0:0.##} руб.}" Name="PriceBox" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <Button Content="{Binding ButtonType}" Name="ConfirmBtn" 
                Click="ConfirmBtn_Click" Grid.Column="1" Grid.Row="9" Margin="10" Padding="10" 
                Background="#00FA9A" VerticalAlignment="Bottom" Width="200" HorizontalAlignment="Right"/>
        <Button Content="Отмена" Name="CancelBtn" 
                Click="CancelBtn_Click" Grid.Column="0" Grid.Row="9" Margin="10" Padding="10" 
                Background="#7FFF00" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="200"/>

    </Grid>
</Window>
