<Window x:Class="demo2.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo2"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        FontSize="18"
        FontFamily="Times New Roman"
        Background="#FFFFFF"
        Title="Вход" Height="450" Width="400">

    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
        <Image Source="/Images/Icon.png" Width="100"/>
        <TextBlock Text="Обувь" TextAlignment="Center" FontSize="20"/>
        <TextBlock Text="Логин" Margin="20,40,20,10" TextAlignment="Center"/>
        <TextBox Text="{Binding Login}"/>
        <TextBlock Text="Пароль" Margin="20,10,20,10" TextAlignment="Center"/>
        <PasswordBox Name="Password"/>
        <Button Name="LoginBtn" Click="LoginBtn_Click" 
                Content="Войти" Margin="0,30,0,10"
                FontSize="20" Background="#00FA9A"/>
        <Button Name="LoginAsGuestBtn" Click="LoginAsGuestBtn_Click" 
                Content="Войти как гость" 
                BorderThickness="0" Background="#FFFFFF"/>
    </StackPanel>
</Window>